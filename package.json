{
  "name": "nirdjs",
  "type": "module",
  "version": "0.1.32",
  "description": "An atomic state management library for React",
  "source": "./index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "exports": {
    "./index.d.ts": {
      "types": "./dist/index.d.ts"
    },
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs,iife --clean",
    "test": "bun test && npm run test.modules",
    "test:watch": "bun test --watch",
    "test.cjs": "cd ./test-module-imports/test-cjs/ && npm run test",
    "test.esm": "cd ./test-module-imports/test-esm/ && npm run test",
    "test.modules": "npm run build && npm run test.cjs && npm run test.esm",
    "format": "prettier --write ./src/ ./test/",
    "lint": "prettier --check ./src ./test",
    "clean": "rm -rf dist",
    "up": "bun upgrade && bun update --force && npm run build",
    "deno:publish": "deno publish --unstable-sloppy-imports --allow-dirty",
    "deno:prepare": "deno publish --unstable-sloppy-imports --allow-dirty --dry-run"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@microsoft/api-extractor": "^7.58.2",
    "@types/bun": "^1.3.12",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "tsup": "^8.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "Apache-2.0",
  "author": "Dima Kaigorodov",
  "keywords": [
    "react",
    "state management",
    "frontend",
    "state",
    "manager",
    "management",
    "recoil",
    "jotai",
    "atom",
    "atomic",
    "react",
    "charm",
    "charmjs",
    "zustand",
    "store"
  ],
  "homepage": "https://npmjs.com/nirdjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirdjs/nirdjs.git"
  }
}